@implements IDisposable
@inject IRecipeExportService RecipeExportService
@inject IFileSystemAccessService FileSystemAccess
@inject IConnectionStateService ConnectionState
@inject IToastService ToastService
@inject NavigationManager NavigationManager

<div class="header-container">
    <div class="header-brand" @onclick="NavigateToHome">
        <img src="icon-192-no-background.png" alt="Reci Unicorn" class="header-logo" />
        <FluentLabel Typo="Typography.Header" Color="Color.Lightweight" Weight="FontWeight.Bold">
            Reci
        </FluentLabel>
    </div>

    <SearchBar />

    <div class="header-actions">
        @if (ConnectionState.IsConnected)
        {
            <FluentLabel Color="Color.Lightweight" Typo="Typography.Body" Style="opacity: 0.7; margin-right: 8px;">
                @ConnectionState.FolderName
            </FluentLabel>

            <FluentButton Appearance="Appearance.Lightweight"
                          IconEnd="@(new Icons.Regular.Size20.ArrowDownload())"
                          OnClick="OnExportClick"
                          Title="@exportTooltip"
                          Loading="@isExporting">
            </FluentButton>

            <FluentButton Appearance="Appearance.Lightweight"
                          IconEnd="@(new Icons.Regular.Size20.PlugDisconnected())"
                          OnClick="OnDisconnectClick"
                          Title="Disconnect folder">
            </FluentButton>
        }
    </div>
</div>

@code {
    private bool isExporting;
    private string exportTooltip = "Export all recipes";

    protected override void OnInitialized()
    {
        ConnectionState.ConnectionStateChanged += OnConnectionStateChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateExportTooltip();
    }

    private async Task OnConnectionStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateExportTooltip();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateExportTooltip()
    {
        ExportContext context = GetExportContext();
        exportTooltip = context.Kind switch
        {
            ExportKind.Recipe => "Export recipe",
            ExportKind.Group => $"Export {context.Value} group",
            _ => "Export all recipes"
        };
    }

    private void NavigateToHome()
    {
        string currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (!string.IsNullOrEmpty(currentPath))
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task OnExportClick()
    {
        try
        {
            isExporting = true;

            ExportContext context = GetExportContext();

            switch (context.Kind)
            {
                case ExportKind.Recipe:
                {
                    RecipeKey key = RecipeKey.FromSlug(context.Value!);
                    RecipeExportResult? result = await RecipeExportService.ExportRecipeAsync(key);

                    if (result is null)
                    {
                        ToastService.ShowError("Failed to export recipe");
                        return;
                    }

                    await FileSystemAccess.DownloadBlobAsync(result.FileName, result.Content, "application/json");
                    ToastService.ShowSuccess("Recipe exported");
                    break;
                }
                case ExportKind.Group:
                {
                    byte[]? zipBytes = await RecipeExportService.ExportGroupAsZipAsync(context.Value!);

                    if (zipBytes is null)
                    {
                        ToastService.ShowError("Failed to export group");
                        return;
                    }

                    string fileName = $"{context.Value}.zip";
                    await FileSystemAccess.DownloadBlobAsync(fileName, zipBytes, "application/zip");
                    ToastService.ShowSuccess("Group exported");
                    break;
                }
                default:
                {
                    byte[]? zipBytes = await RecipeExportService.ExportAllAsZipAsync();

                    if (zipBytes is null)
                    {
                        ToastService.ShowError("Failed to export recipes");
                        return;
                    }

                    string fileName = $"reci-export-{DateTime.Now:yyyy-MM-dd-HHmmss}.zip";
                    await FileSystemAccess.DownloadBlobAsync(fileName, zipBytes, "application/zip");
                    ToastService.ShowSuccess("All recipes exported");
                    break;
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Export failed: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task OnDisconnectClick()
    {
        await ConnectionState.DisconnectAsync();
    }

    private ExportContext GetExportContext()
    {
        string relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        if (relativePath.StartsWith("Recipe/", StringComparison.OrdinalIgnoreCase)
            && relativePath.Length > "Recipe/".Length)
        {
            string slug = relativePath["Recipe/".Length..];
            return new ExportContext(ExportKind.Recipe, slug);
        }

        if (relativePath.StartsWith("group/", StringComparison.OrdinalIgnoreCase)
            && relativePath.Length > "group/".Length)
        {
            string groupName = Uri.UnescapeDataString(relativePath["group/".Length..]);
            return new ExportContext(ExportKind.Group, groupName);
        }

        return new ExportContext(ExportKind.All, null);
    }

    public void Dispose()
    {
        ConnectionState.ConnectionStateChanged -= OnConnectionStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private enum ExportKind { All, Group, Recipe }
    private readonly record struct ExportContext(ExportKind Kind, string? Value);
}