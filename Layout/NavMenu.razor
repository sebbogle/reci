
@implements IAsyncDisposable
@inject IDialogService DialogService
@inject IRecipeService RecipeService
@inject IRecipeStateNotifier RecipeStateNotifier
@inject IConnectionStateService ConnectionState


<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
    <label for="navmenu-toggle" class="navmenu-icon"><FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Fill" /></label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNavMenu Id="main-menu" Width="250" Collapsible="true" Title="Navigation menu" @bind-Expanded="expanded" CustomToggle="true">
             <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.BookOpen())" IconColor="Color.Accent">Contents</FluentNavLink>

             @if (ConnectionState.IsConnected)
             {
                 @foreach (IGrouping<string?, RecipeSummary> recipeGroup in recipeSummaries.GroupBy(r => r.Group).OrderBy(g => g.Key ?? string.Empty))
                {
                    @if (!string.IsNullOrEmpty(recipeGroup.Key))
                    {
                        <FluentNavGroup Title="@recipeGroup.Key"
                                        Icon="@(new Icons.Regular.Size20.FolderOpen())"
                                        Href="@($"/group/{Uri.EscapeDataString(recipeGroup.Key)}")">
                            @RenderRecipes(recipeGroup)
                        </FluentNavGroup>
                    }
                    else
                    {
                        @RenderRecipes(recipeGroup)
                    }
                }
             }

            <FluentDivider Style="margin: 10px 0;"></FluentDivider>

            <FluentNavLink Icon="@(new Icons.Regular.Size20.Add())"
                           OnClick="AddNewRecipe"
                           Disabled="@(!ConnectionState.IsConnected)">
                Add New Recipe
            </FluentNavLink>

         </FluentNavMenu>
    </nav>
</div>

@code {
    private bool expanded = true;
    private IDialogReference? _dialog;

    private List<RecipeSummary> recipeSummaries = new();
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        ConnectionState.ConnectionStateChanged += OnConnectionStateChanged;
        RecipeStateNotifier.Subscribe(OnRecipesChanged);

        if (ConnectionState.IsConnected)
        {
            await LoadRecipesAsync();
        }
    }

    private async Task LoadRecipesAsync()
    {
        recipeSummaries = await RecipeService.GetRecipeSummariesAsync(_cts.Token);
    }

    private async Task OnRecipesChanged()
    {
        try
        {
            if (_cts.Token.IsCancellationRequested) return;
            await LoadRecipesAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Component is being disposed, ignore.
        }
        catch (ObjectDisposedException)
        {
            // Component already disposed, ignore.
        }
    }

    private async Task OnConnectionStateChanged()
    {
        try
        {
            if (_cts.Token.IsCancellationRequested) return;

            if (ConnectionState.IsConnected)
            {
                await LoadRecipesAsync();
            }
            else
            {
                recipeSummaries = new();
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Component is being disposed, ignore.
        }
        catch (ObjectDisposedException)
        {
            // Component already disposed, ignore.
        }
    }

    public ValueTask DisposeAsync()
    {
        ConnectionState.ConnectionStateChanged -= OnConnectionStateChanged;
        RecipeStateNotifier.Unsubscribe(OnRecipesChanged);
        _cts.Cancel();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }

    private RenderFragment RenderRecipes(IGrouping<string?, RecipeSummary> recipeGroup) => __builder =>
    {
        @foreach (RecipeSummary recipe in recipeGroup)
        {
            <FluentNavLink Href="@($"/recipe/{recipe.Slug}")"
                           Icon="@(new Icons.Regular.Size20.Food())">
                @recipe.Name
            </FluentNavLink>
        }
    };

    private async Task AddNewRecipe()
    {
        _dialog = await DialogService.ShowPanelAsync<RecipeEditor>(new DialogParameters()
        {
            Alignment = HorizontalAlignment.Left,
            Title = "New Recipe",
            PrimaryAction = "Save",
            ShowDismiss = false,
            Width = "var(--panel-width, 950px)",
            PreventDismissOnOverlayClick = true,
        });
        DialogResult result = await _dialog.Result;
    }
}
