@typeparam TItem where TItem : IGroupable

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="margin-bottom: 12px">
    <FluentLabel Typo="Typography.Subject">@Title</FluentLabel>

    @{
        List<TItem> ungroupedItems = Items.Where(i => string.IsNullOrEmpty(i.Group)).ToList();
        int ungroupedIndex = 0;
    }
    @foreach (TItem item in ungroupedItems)
    {
        ungroupedIndex++;
        int displayIndex = ungroupedIndex;
        <FluentStack Orientation="Orientation.Horizontal"
                     HorizontalGap="8"
                     VerticalAlignment="VerticalAlignment.Top">

            <FluentLabel Style="min-width: 15px; font-weight: bold; padding-top: 8px;">
                @displayIndex.
            </FluentLabel>

            @if (ItemTemplate != null)
            {
                @ItemTemplate(item)
            }

            <FluentButton IconEnd="@(new Icons.Regular.Size16.Delete())"
                          Appearance="Appearance.Lightweight"
                          OnClick="@(() => RemoveItem(item))"
                          Title="@RemoveItemTitle" />
        </FluentStack>
    }

    @{
        List<IGrouping<string, TItem>> actualGroups = Items
            .Where(i => !string.IsNullOrEmpty(i.Group))
            .GroupBy(i => i.Group!)
            .ToList();
    }

    @if (actualGroups.Any())
    {
        <FluentAccordion ExpandMode="AccordionExpandMode.Multi" Style="width: 100%">
            @foreach (IGrouping<string, TItem> group in actualGroups)
            {
                string groupName = group.Key;
                groupedViewState.TryGetValue(groupName, out GroupedViewState? state);
                if (state is null) state = GroupedViewState.Default;

                int itemNumber = 1;
                <FluentAccordionItem Expanded="state.IsExpanded" ExpandedChanged="@(() => OnAccordionExpandChange(state))">
                    <HeadingTemplate>
                        <div @onclick:stopPropagation="true">
                        <FluentStack Orientation="Orientation.Horizontal" 
                                     HorizontalAlignment="HorizontalAlignment.Left" 
                                     VerticalAlignment="VerticalAlignment.Center"
                                     Style="width: 100%; justify-content: space-between;">
                            <FluentStack Orientation="Orientation.Horizontal" 
                                         HorizontalGap="8" 
                                         VerticalAlignment="VerticalAlignment.Center">
                                @if (state.IsEditingName)
                                {
                                    <FluentTextField @bind-Value="state.NewName" />
                                }
                                else
                                {
                                    <div>@groupName</div>
                                }
                                
                                @if (!state.IsExpanded)
                                {
                                    <FluentBadge Appearance="Appearance.Neutral">
                                        @group.Count()
                                    </FluentBadge>                                
                                }
                            </FluentStack>
                            
                            <FluentStack Orientation="Orientation.Horizontal"
                                         HorizontalAlignment="HorizontalAlignment.Right" 
                                         HorizontalGap="4"
                                         @onclick:stopPropagation="true">
                                @if (state.IsEditingName)
                                {
                                    <FluentButton IconEnd="@(new Icons.Regular.Size16.Checkmark())"
                                                  Appearance="Appearance.Lightweight"
                                                  Title="Rename group"
                                                  OnClick="@(() => OnConfirmGroupNameEditClick(state, groupName))" />
                                    <FluentButton IconEnd="@(new Icons.Regular.Size16.Dismiss())"
                                                  Appearance="Appearance.Lightweight"
                                                  Title="Rename group"
                                                  OnClick="@(() => OnCancelGroupNameEditClick(state, groupName))" />
                                }
                                else
                                {
                                    <FluentButton IconEnd="@(new Icons.Regular.Size16.Edit())"
                                                  Appearance="Appearance.Lightweight"
                                                  Title="Rename group"
                                                  OnClick="@(() => OnEditGroupNameClick(state))" />
                                    <FluentButton IconEnd="@(new Icons.Regular.Size16.Delete())"
                                                  Appearance="Appearance.Lightweight"
                                                  Title="Delete group"
                                                  OnClick="@(() => RemoveGroup(groupName))" />
                                }
                            </FluentStack>
                            </FluentStack>
                        </div>
                    </HeadingTemplate>
                    <ChildContent>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="padding: 8px 0;">
                        @foreach (TItem item in group)
                        {
                            int currentNumber = itemNumber++;
                            <FluentStack Orientation="Orientation.Horizontal"
                                         HorizontalGap="8"
                                         VerticalAlignment="VerticalAlignment.Top">

                                <FluentLabel Style="min-width: 15px; font-weight: bold; padding-top: 8px;">
                                    @currentNumber.
                                </FluentLabel>

                                @if (ItemTemplate != null)
                                {
                                    @ItemTemplate(item)
                                }

                                <FluentButton IconEnd="@(new Icons.Regular.Size16.Delete())"
                                              Appearance="Appearance.Lightweight"
                                              Title="@RemoveItemTitle"
                                              OnClick="@(() => RemoveItem(item))" />
                            </FluentStack>
                        }

                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Icons.Regular.Size16.Add())"
                                      OnClick="@(() => AddItemToGroup(groupName))">
                            @AddItemButtonText
                        </FluentButton>
                        </FluentStack>
                    </ChildContent>
                </FluentAccordionItem>
            }
        </FluentAccordion>
    }

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
        <FluentButton Appearance="Appearance.Stealth"
                      IconStart="@(new Icons.Regular.Size16.Add())"
                      OnClick="AddUngroupedItem">
            @AddItemButtonText
        </FluentButton>
        <FluentButton Appearance="Appearance.Outline"
                      IconStart="@(new Icons.Regular.Size16.FolderAdd())"
                      OnClick="AddNewGroup">
            @AddGroupButtonText
        </FluentButton>
    </FluentStack>
</FluentStack>

@code {

    #region Component Parameters

    [Parameter]
    public List<TItem> Items { get; set; } = new();

    [Parameter]
    public RenderFragment<TItem>? ItemTemplate { get; set; }

    [Parameter]
    public Func<TItem> CreateNewItem { get; set; } = default!;

    [Parameter]
    public Func<TItem, bool> HasContent { get; set; } = _ => true;

    [Parameter]
    public string Title { get; set; } = "Items";

    [Parameter]
    public string DefaultGroupName { get; set; } = "Group";

    [Parameter]
    public string AddItemButtonText { get; set; } = "Add Item";

    [Parameter]
    public string AddGroupButtonText { get; set; } = "Add Group";

    [Parameter]
    public string RemoveItemTitle { get; set; } = "Remove item";

    #endregion

    #region Event Handlers

    private void OnAccordionExpandChange(GroupedViewState groupedViewState)
    {
        groupedViewState.IsExpanded = !groupedViewState.IsExpanded;
    }

    private void OnEditGroupNameClick(GroupedViewState state)
    {
        state.IsEditingName = true;
    }

    private void OnConfirmGroupNameEditClick(GroupedViewState state, string oldGroupName)
    {
        string? newName = state.NewName?.Trim();
        if (!string.IsNullOrEmpty(newName) && newName != oldGroupName)
        {
            foreach (TItem item in Items.Where(i => i.Group == oldGroupName))
            {
                item.Group = newName;
            }

            groupedViewState.Remove(oldGroupName);
            groupedViewState[newName] = state;
        }
        state.IsEditingName = false;
    }

    private void OnCancelGroupNameEditClick(GroupedViewState state, string groupName)
    {
        state.NewName = groupName;
        state.IsEditingName = false;
    }

    #endregion

    private Dictionary<string, GroupedViewState> groupedViewState = new();

    protected override void OnInitialized()
    {
        if (!Items.Any())
        {
            AddUngroupedItem();
        }

        List<string> existingGroups = Items
            .Where(i => !string.IsNullOrEmpty(i.Group))
            .Select(i => i.Group!)
            .Distinct()
            .ToList();

        foreach (string groupName in existingGroups)
        {
            groupedViewState[groupName] = new GroupedViewState
            {
                IsExpanded = false,
                IsEditingName = false,
                NewName = groupName
            };
        }
    }

    #region Private Methods

    private void AddNewGroup()
    {
        int groupCount = Items.Where(i => !string.IsNullOrEmpty(i.Group)).Select(i => i.Group).Distinct().Count();
        string newGroupName = $"{DefaultGroupName} {groupCount + 1}";

        TItem newItem = CreateNewItem();
        newItem.Group = newGroupName;
        Items.Add(newItem);

        groupedViewState[newGroupName] = new GroupedViewState
        {
            IsExpanded = true,
            IsEditingName = false,
            NewName = newGroupName
        };
    }

    private void AddItemToGroup(string groupName)
    {
        TItem newItem = CreateNewItem();
        newItem.Group = groupName;
        Items.Add(newItem);
    }

    private void AddUngroupedItem()
    {
        TItem newItem = CreateNewItem();
        Items.Add(newItem);
    }

    private void RemoveItem(TItem item)
    {
        Items.Remove(item);
    }

    private void RemoveGroup(string groupName)
    {
        foreach (TItem item in Items.Where(i => i.Group == groupName).ToList())
        {
            if (HasContent(item))
            {
                item.Group = null;
            }
            else
            {
                Items.Remove(item);
            }
        }

        groupedViewState.Remove(groupName);
    }

    #endregion

    private class GroupedViewState
    {
        public bool IsExpanded { get; set; }

        public bool IsEditingName { get; set; }

        public string? NewName { get; set; }

        public static GroupedViewState Default => new GroupedViewState
        {
            IsExpanded = false,
            IsEditingName = false,
            NewName = null
        };
    }
}
