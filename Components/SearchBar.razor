@implements IAsyncDisposable
@inject ISearchService SearchService
@inject IRecipeService RecipeService
@inject IRecipeStateNotifier RecipeStateNotifier
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<FluentAutocomplete TOption="SearchResult"
                    AutoComplete="off"
                    Placeholder="Search recipes..."
                    Width="var(--search-bar-width)"
                    Multiple="false"
                    OptionText="@(r => r.Name)"
                    OnOptionsSearch="OnSearch"
                    ShowOverlayOnEmptyResults="false"
                    @bind-SelectedOption="selectedResult"
                    @bind-SelectedOption:after="OnResultSelected">
    <OptionTemplate>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Width="calc(var(--search-bar-width) - 26px)">
            <FluentIcon Value="@GetKindIcon(context.Kind)" />
            <span style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;" title="@context.Name">@context.Name</span>
            <FluentIcon Value="@GetMatchMethodIcon(context.MatchMethod)" />
        </FluentStack>
    </OptionTemplate>
</FluentAutocomplete>

@code {
    private List<RecipeSummary> cachedSummaries = [];
    private SearchResult? selectedResult = null;
    private Func<Task>? notifierCallback;

    protected override async Task OnInitializedAsync()
    {
        notifierCallback = OnRecipesChanged;
        RecipeStateNotifier.Subscribe(notifierCallback);
        NavigationManager.LocationChanged += OnLocationChanged;
        cachedSummaries = await RecipeService.GetRecipeSummariesAsync();
    }

    private void OnSearch(OptionsSearchEventArgs<SearchResult> e)
    {
        if (string.IsNullOrWhiteSpace(e.Text))
        {
            e.Items = Enumerable.Empty<SearchResult>();
            return;
        }

        e.Items = SearchService.Search(e.Text, cachedSummaries);
    }

    private async Task OnResultSelected()
    {
        if (selectedResult is null)
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync("eval", "document.activeElement.blur()");
        NavigationManager.NavigateTo(selectedResult.NavigationUrl);
    }

    private async Task OnRecipesChanged()
    {
        cachedSummaries = await RecipeService.GetRecipeSummariesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        selectedResult = null;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;

        if (notifierCallback is not null)
        {
            RecipeStateNotifier.Unsubscribe(notifierCallback);
        }

        await ValueTask.CompletedTask;
    }

    private static Icon GetKindIcon(SearchResultKind kind) => kind switch
    {
        SearchResultKind.Recipe => new Icons.Regular.Size16.Food(),
        SearchResultKind.Group => new Icons.Regular.Size16.Folder(),
        _ => new Icons.Regular.Size16.QuestionCircle()
    };

    private static Icon GetMatchMethodIcon(MatchMethod matchMethod) => matchMethod switch
    {
        MatchMethod.Name => new Icons.Regular.Size16.TextCaseTitle(),
        MatchMethod.Tag => new Icons.Regular.Size16.Tag(),
        MatchMethod.Description => new Icons.Regular.Size16.TextDescription(),
        _ => new Icons.Regular.Size16.QuestionCircle()
    };
}
