        "black-beans",
        "vegetarian",
        "quick",
        "weeknight",
        "mexican",
        "budget"
      ],
      "FurtherNotes": "Makes 4 servings (8 tacos). Prep time: 5 minutes, Cook time: 10 minutes. Seasoned beans keep refrigerated for 5 days. Double the beans for easy burrito bowls throughout the week."
    },
    {
      "Id": "aa6aed4d-2496-4ec8-b936-915b9ceff204",
