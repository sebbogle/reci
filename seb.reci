        },
        {
          "Name": "pinch of salt",
          "QuantityAmount": 1,
          "QuantityUnit": "pinch",
          "GroupId": "a71e639e-7329-4a93-9b0b-0e09037eeb60"
        },
        {
          "Name": "maple syrup",
          "QuantityAmount": 1,
          "QuantityUnit": "to taste",
          "GroupId": "32682319-0dd0-45b4-8071-f3a3e8ba5d8f"
        },
        {
          "Name": "fresh berries",
          "QuantityAmount": 1,
          "QuantityUnit": "cup",
          "GroupId": "32682319-0dd0-45b4-8071-f3a3e8ba5d8f"
        },
        {
          "Name": "nut butter",
          "QuantityAmount": 2,
          "QuantityUnit": "tbsp",
          "GroupId": "32682319-0dd0-45b4-8071-f3a3e8ba5d8f"
        },
        {
          "Name": "sliced banana",
          "QuantityAmount": 1,
          "QuantityUnit": "whole",
          "GroupId": "32682319-0dd0-45b4-8071-f3a3e8ba5d8f"
        }
      ],
      "Instructions": [
        {
          "Text": "Add oats to a blender and pulse until they form a flour-like consistency",
          "GroupId": "8922b627-d4f4-42ad-ba75-f192ae363ac8"
        },
        {
          "Text": "Add bananas, eggs, milk, baking powder, cinnamon, vanilla, and salt. Blend until smooth",
          "GroupId": "8922b627-d4f4-42ad-ba75-f192ae363ac8"
        },
        {
          "Text": "Let batter rest 5 minutes to thicken slightly",
          "GroupId": "8922b627-d4f4-42ad-ba75-f192ae363ac8"
        },
        {
          "Text": "Heat a non-stick pan or griddle over medium heat with a little butter or oil",
          "GroupId": "f3036311-31bb-4695-bfbe-cc4bb20c31fb"
        },
        {
          "Text": "Pour 1/4 cup batter per pancake. Cook 2-3 minutes until bubbles form on surface and edges look set",
          "GroupId": "f3036311-31bb-4695-bfbe-cc4bb20c31fb"
        },
        {
          "Text": "Flip and cook 1-2 minutes more until golden brown. Serve with desired toppings",
          "GroupId": "f3036311-31bb-4695-bfbe-cc4bb20c31fb"
        }
      ],
      "NutritionInfo": null,
      "Source": {
        "Text": "Downshiftology",
        "Url": "https://downshiftology.com/recipes/banana-oat-pancakes/"
      },
      "Tags": [
        "breakfast",
        "pancakes",
        "banana",
        "oats",
        "healthy",
        "gluten-free",
        "meal-prep"
      ],
      "FurtherNotes": "Makes about 10 pancakes (3-4 servings). Prep time: 5 minutes, Cook time: 15 minutes. Freeze cooked pancakes in a single layer, then stack in a bag. Reheat in toaster or microwave. Naturally gluten-free if using certified GF oats."
    },
    {
      "Id": "d675762a-45e2-415b-85d5-34d9920c2a95",
      "Name": "Chocolate Protein Balls",
      "Description": "Rich, fudgy no-bake energy balls packed with oats, peanut butter, and chocolate chips. The perfect pre-workout or afternoon snack.",
      "GroupId": "e8d37bad-ff4a-4320-947e-e4fad6968658",
      "Ingredients": [
        {
          "Name": "rolled oats",
          "QuantityAmount": 1,
          "QuantityUnit": "cup",
          "GroupId": null
        },
        {
          "Name": "peanut butter",
          "QuantityAmount": 0.5,
          "QuantityUnit": "cup",
          "GroupId": null
        },
        {
          "Name": "honey",
          "QuantityAmount": 0.33,
          "QuantityUnit": "cup",
          "GroupId": null
        },
        {
          "Name": "chocolate protein powder",
          "QuantityAmount": 0.33,
          "QuantityUnit": "cup",
          "GroupId": null
        },
        {
          "Name": "dark chocolate chips",
          "QuantityAmount": 0.33,
          "QuantityUnit": "cup",
          "GroupId": null
        },
        {
          "Name": "flaxseed meal",
          "QuantityAmount": 2,
          "QuantityUnit": "tbsp",
          "GroupId": null
        },
        {
          "Name": "vanilla extract",
          "QuantityAmount": 1,
          "QuantityUnit": "tsp",
          "GroupId": null
        },
        {
          "Name": "cocoa powder (optional, for rolling)",
          "QuantityAmount": 2,
          "QuantityUnit": "tbsp",
          "GroupId": null
        }
      ],
      "Instructions": [
        {
          "Text": "Combine oats, peanut butter, honey, protein powder, chocolate chips, flaxseed, and vanilla in a large bowl. Mix until fully combined",
          "GroupId": null
        },
        {
          "Text": "If mixture is too dry, add a splash of milk. If too sticky, add a tablespoon more oats",
          "GroupId": null
        },
        {
          "Text": "Refrigerate the mixture for 15-20 minutes to firm up",
          "GroupId": null
        },
        {
          "Text": "Roll into 20 balls (about 1 tablespoon each). Optionally roll in cocoa powder for coating",
          "GroupId": null
        },
        {
          "Text": "Store in an airtight container in the fridge. Enjoy cold or at room temperature",
          "GroupId": null
        }
      ],
      "NutritionInfo": null,
      "Source": {
        "Text": "Ambitious Kitchen",
        "Url": "https://www.ambitiouskitchen.com/no-bake-chocolate-energy-bites/"
      },
      "Tags": [
        "snack",
        "no-bake",
        "protein",
        "chocolate",
        "energy-balls",
        "healthy",
        "meal-prep"
      ],
      "FurtherNotes": "Makes 20 balls. Prep time: 10 minutes, No cook time (requires 15 min chilling). Storage: Refrigerate up to 2 weeks, freeze up to 3 months. Swap peanut butter for almond butter if preferred. Each ball is roughly 95 calories with 4g protein."
    },
    {
      "Id": "e320505b-b744-4217-b11a-c79cb299b32e",
      "Name": "Caprese Stuffed Chicken",
      "Description": "Juicy chicken breasts stuffed with fresh mozzarella, sun-dried tomatoes, and basil, wrapped in prosciutto. An impressive weeknight dinner in under 30 minutes.",
      "GroupId": "800818ac-3fc8-4d36-92ff-a9f723396bbd",
      "Ingredients": [
        {
          "Name": "boneless skinless chicken breasts",
          "QuantityAmount": 4,
          "QuantityUnit": "whole",
          "GroupId": null
        },
        {
          "Name": "fresh mozzarella, sliced",
          "QuantityAmount": 125,
          "QuantityUnit": "g",
          "GroupId": null
        },
        {
          "Name": "sun-dried tomatoes, chopped",
          "QuantityAmount": 0.33,
          "QuantityUnit": "cup",
          "GroupId": null
        },
        {
          "Name": "fresh basil leaves",
          "QuantityAmount": 8,
          "QuantityUnit": "whole",
          "GroupId": null
        },
        {
          "Name": "prosciutto slices",
          "QuantityAmount": 8,
          "QuantityUnit": "whole",
          "GroupId": null
        },
        {
          "Name": "olive oil",
          "QuantityAmount": 1,
          "QuantityUnit": "tbsp",
          "GroupId": null
        },
        {
          "Name": "garlic powder",
          "QuantityAmount": 0.5,
          "QuantityUnit": "tsp",
          "GroupId": null
        },
        {
          "Name": "Italian seasoning",
          "QuantityAmount": 0.5,
          "QuantityUnit": "tsp",
          "GroupId": null
        },
        {
          "Name": "salt and pepper",
          "QuantityAmount": 1,
          "QuantityUnit": "to taste",
          "GroupId": null
        },
        {
          "Name": "balsamic glaze, for drizzling",
          "QuantityAmount": 2,
          "QuantityUnit": "tbsp",
          "GroupId": null
        }
      ],
      "Instructions": [
        {
          "Text": "Preheat oven to 200\u00C2\u00B0C (400\u00C2\u00B0F). Cut a deep pocket horizontally into each chicken breast, being careful not to slice all the way through",
          "GroupId": null
        },
        {
          "Text": "Season chicken inside and out with garlic powder, Italian seasoning, salt, and pepper",
          "GroupId": null
        },
        {
          "Text": "Stuff each breast with mozzarella slices, sun-dried tomatoes, and 2 basil leaves",
          "GroupId": null
        },
        {
          "Text": "Wrap each stuffed breast with 2 slices of prosciutto to seal the opening",
          "GroupId": null
        },
        {
          "Text": "Heat olive oil in an oven-safe skillet over medium-high heat. Sear chicken 2-3 minutes per side until prosciutto is crispy",
          "GroupId": null
        },
        {
          "Text": "Transfer skillet to oven and bake 15-18 minutes until chicken reaches 74\u00C2\u00B0C (165\u00C2\u00B0F) internally",
          "GroupId": null
        },
        {
          "Text": "Let rest 5 minutes, then drizzle with balsamic glaze before serving",
          "GroupId": null
        }
      ],
      "NutritionInfo": null,
      "Source": {
        "Text": "Cafe Delites",
        "Url": "https://cafedelites.com/caprese-stuffed-chicken/"
      },
      "Tags": [
        "chicken",
        "italian",
        "caprese",
        "weeknight",
        "dinner",
        "low-carb",
        "impressive"
      ],
      "FurtherNotes": "Makes 4 servings. Prep time: 10 minutes, Cook time: 20 minutes. Serve with roasted vegetables, salad, or garlic bread. Leftover chicken slices well for next-day sandwiches or salads. Secure prosciutto with toothpicks if needed."
    },
    {
      "Id": "93145c3e-c94a-471e-89ef-c9885980e228",
      "Name": "Protein Waffles",
      "Description": "Crispy, golden waffles packed with protein from eggs and protein powder, naturally sweetened with banana. A quick, healthy breakfast or snack that doubles as pancake batter.",
      "GroupId": "e8d37bad-ff4a-4320-947e-e4fad6968658",
      "Ingredients": [
        {
          "Name": "Oats",
          "QuantityAmount": 150,
          "QuantityUnit": "g",
          "GroupId": null
        },
        {
          "Name": "Eggs",
          "QuantityAmount": 6,
          "QuantityUnit": "",
          "GroupId": null
        },
        {
          "Name": "Bananas",
          "QuantityAmount": 2,
          "QuantityUnit": "",
          "GroupId": null
        },
        {
          "Name": "Protein Powder",
          "QuantityAmount": 60,
          "QuantityUnit": "g",
          "GroupId": null
        },
        {
          "Name": "Milk",
          "QuantityAmount": 4,
          "QuantityUnit": "tbsp",
          "GroupId": null
        },
        {
          "Name": "Baking Powder",
          "QuantityAmount": 1,
          "QuantityUnit": "tsp",
          "GroupId": null
        },
        {
          "Name": "Cinnamon",
          "QuantityAmount": 1,
          "QuantityUnit": "tsp",
          "GroupId": null
        }
      ],
      "Instructions": [
        {
          "Text": "Blend the oats into oat flour.",
          "GroupId": null
        },
        {
          "Text": "Add in the eggs, bananas, protein powder, milk, baking powder and cinnamon and blend until smooth.",
          "GroupId": null
        },
        {
          "Text": "Cook the mixture with a waffle maker until firm and golden brown.",
          "GroupId": null
        },
        {
          "Text": "Optionally, serve with berries.",
          "GroupId": null
        }
      ],
      "NutritionInfo": null,
      "Source": null,
      "Tags": [
        "Protein"
      ],
      "FurtherNotes": "The mix can also be used for Protein Pancakes!"
    }
  ],
