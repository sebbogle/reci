          "QuantityUnit": "whole",
          "GroupId": "f6393b2d-7828-4db7-8a77-731588ce5cbf"
        },
        {
          "Name": "cherry tomatoes, halved",
          "QuantityAmount": 1,
          "QuantityUnit": "cup",
          "GroupId": "f6393b2d-7828-4db7-8a77-731588ce5cbf"
        },
        {
          "Name": "red onion, thinly sliced",
          "QuantityAmount": 0.5,
          "QuantityUnit": "whole",
          "GroupId": "f6393b2d-7828-4db7-8a77-731588ce5cbf"
        },
        {
          "Name": "Kalamata olives",
          "QuantityAmount": 0.25,
          "QuantityUnit": "cup",
          "GroupId": "f6393b2d-7828-4db7-8a77-731588ce5cbf"
        },
        {
          "Name": "crumbled feta cheese",
          "QuantityAmount": 100,
          "QuantityUnit": "g",
          "GroupId": "f6393b2d-7828-4db7-8a77-731588ce5cbf"
        },
        {
          "Name": "Greek yogurt",
          "QuantityAmount": 1,
          "QuantityUnit": "cup",
          "GroupId": "54889718-2ed5-4157-9504-7fbc79ac2ca7"
        },
        {
          "Name": "cucumber, grated and squeezed dry",
          "QuantityAmount": 0.5,
          "QuantityUnit": "cup",
          "GroupId": "54889718-2ed5-4157-9504-7fbc79ac2ca7"
        },
        {
          "Name": "garlic, minced",
          "QuantityAmount": 1,
          "QuantityUnit": "clove",
          "GroupId": "54889718-2ed5-4157-9504-7fbc79ac2ca7"
        },
        {
          "Name": "lemon juice",
          "QuantityAmount": 1,
          "QuantityUnit": "tbsp",
          "GroupId": "54889718-2ed5-4157-9504-7fbc79ac2ca7"
        },
        {
          "Name": "fresh dill, chopped",
          "QuantityAmount": 1,
          "QuantityUnit": "tbsp",
          "GroupId": "54889718-2ed5-4157-9504-7fbc79ac2ca7"
        },
        {
          "Name": "salt",
          "QuantityAmount": 0.5,
          "QuantityUnit": "tsp",
          "GroupId": "54889718-2ed5-4157-9504-7fbc79ac2ca7"
        }
      ],
      "Instructions": [
        {
          "Text": "Marinate chicken in olive oil, lemon juice, oregano, garlic, and salt for at least 20 minutes",
          "GroupId": "20dab97f-dc9c-403f-a3b9-f704816eccc1"
        },
        {
          "Text": "Cook rice according to package directions. Let cool slightly",
          "GroupId": "20dab97f-dc9c-403f-a3b9-f704816eccc1"
        },
        {
          "Text": "Grill or pan-sear chicken over medium-high heat, 5-6 minutes per side until internal temp reaches 74\u00C2\u00B0C (165\u00C2\u00B0F). Let rest 5 minutes, then slice",
          "GroupId": "20dab97f-dc9c-403f-a3b9-f704816eccc1"
        },
        {
          "Text": "Make tzatziki: combine yogurt, grated cucumber, garlic, lemon juice, dill, and salt. Refrigerate until serving",
          "GroupId": "20dab97f-dc9c-403f-a3b9-f704816eccc1"
        },
        {
          "Text": "Divide rice among 4 containers. Top with sliced chicken, cucumber, tomatoes, red onion, olives, and feta",
          "GroupId": "4ae8e2dd-7d02-4144-a262-6b19b872a3a4"
        },
        {
          "Text": "Pack tzatziki in small separate containers. Drizzle over bowls when ready to eat",
          "GroupId": "4ae8e2dd-7d02-4144-a262-6b19b872a3a4"
        }
      ],
      "NutritionInfo": null,
      "Source": {
        "Text": "Gimme Delicious",
        "Url": "https://gimmedelicious.com/greek-chicken-bowl/"
      },
      "Tags": [
        "greek",
        "chicken",
        "bowl",
        "meal-prep",
        "mediterranean",
        "lunch",
        "high-protein"
      ],
      "FurtherNotes": "Makes 4 servings. Prep time: 20 minutes (plus marinating), Cook time: 15 minutes. Storage: Refrigerate 4 days. Keep tzatziki separate to prevent sogginess. Swap rice for cauliflower rice for lower carbs."
    },
    {
      "Id": "0dbd4f50-67d5-444a-8d49-f5435c12788f",
      "Name": "Overnight Oats",
      "Description": "Creamy no-cook oats with chia seeds, honey, and vanilla that you prep the night before. Grab-and-go breakfast ready in minutes.",
      "GroupId": "f0682c7f-349f-4948-9277-58c677a2e2f3",
      "Ingredients": [
        {
          "Name": "rolled oats",
          "QuantityAmount": 2.5,
          "QuantityUnit": "cups",
          "GroupId": null
        },
        {
          "Name": "milk of choice",
          "QuantityAmount": 2.5,
          "QuantityUnit": "cups",
          "GroupId": null
        },
        {
          "Name": "Greek yogurt",
          "QuantityAmount": 0.75,
          "QuantityUnit": "cup",
          "GroupId": null
        },
        {
          "Name": "chia seeds",
          "QuantityAmount": 2.5,
          "QuantityUnit": "tbsp",
          "GroupId": null
        },
        {
          "Name": "honey or maple syrup",
          "QuantityAmount": 2.5,
          "QuantityUnit": "tbsp",
          "GroupId": null
        },
        {
          "Name": "vanilla extract",
          "QuantityAmount": 1,
          "QuantityUnit": "tsp",
          "GroupId": null
        },
        {
          "Name": "pinch of salt",
          "QuantityAmount": 1,
          "QuantityUnit": "pinch",
          "GroupId": null
        },
        {
          "Name": "fresh berries, for topping",
          "QuantityAmount": 1.5,
          "QuantityUnit": "cups",
          "GroupId": null
        },
        {
          "Name": "sliced almonds or granola, for topping",
          "QuantityAmount": 0.25,
          "QuantityUnit": "cup",
          "GroupId": null
        }
      ],
      "Instructions": [
        {
          "Text": "In a large bowl, combine oats, milk, yogurt, chia seeds, honey, vanilla, and salt. Stir well",
          "GroupId": null
        },
        {
          "Text": "Divide mixture evenly among 5 jars or containers (about 3/4 cup each)",
          "GroupId": null
        },
        {
          "Text": "Cover tightly and refrigerate for at least 4 hours or overnight",
          "GroupId": null
        },
        {
          "Text": "In the morning, stir the oats and add a splash more milk if too thick",
          "GroupId": null
        },
        {
          "Text": "Top with fresh berries, sliced almonds, or granola before serving",
          "GroupId": null
        }
      ],
      "NutritionInfo": null,
      "Source": {
        "Text": "Love and Lemons",
        "Url": "https://www.loveandlemons.com/overnight-oats-recipe/"
      },
      "Tags": [
        "breakfast",
        "overnight-oats",
        "no-cook",
        "meal-prep",
        "healthy",
        "grab-and-go"
      ],
      "FurtherNotes": "Makes 5 servings. Prep time: 10 minutes, No cook time. Storage: Refrigerate up to 5 days. Variations: PB \u0026 banana, mango coconut, apple cinnamon. Add protein powder for extra nutrition."
    },
    {
      "Id": "87aa2102-6129-4c57-9706-03cab2895540",
      "Name": "Lemon Herb Salmon",
      "Description": "Flaky, buttery salmon fillets baked with lemon, garlic, and fresh herbs. An elegant weeknight dinner that comes together in 20 minutes.",
      "GroupId": "800818ac-3fc8-4d36-92ff-a9f723396bbd",
      "Ingredients": [
        {
          "Name": "salmon fillets",
          "QuantityAmount": 4,
          "QuantityUnit": "whole",
          "GroupId": null
        },
        {
          "Name": "butter, melted",
          "QuantityAmount": 3,
          "QuantityUnit": "tbsp",
          "GroupId": null
        },
        {
          "Name": "garlic, minced",
          "QuantityAmount": 3,
          "QuantityUnit": "cloves",
          "GroupId": null
        },
        {
          "Name": "lemon juice",
          "QuantityAmount": 2,
          "QuantityUnit": "tbsp",
          "GroupId": null
        },
        {
          "Name": "lemon zest",
          "QuantityAmount": 1,
          "QuantityUnit": "tsp",
          "GroupId": null
        },
        {
          "Name": "fresh dill, chopped",
          "QuantityAmount": 2,
          "QuantityUnit": "tbsp",
          "GroupId": null
        },
        {
          "Name": "fresh parsley, chopped",
          "QuantityAmount": 2,
          "QuantityUnit": "tbsp",
          "GroupId": null
        },
        {
          "Name": "salt",
          "QuantityAmount": 0.5,
          "QuantityUnit": "tsp",
          "GroupId": null
        },
        {
          "Name": "black pepper",
          "QuantityAmount": 0.25,
          "QuantityUnit": "tsp",
          "GroupId": null
        },
        {
          "Name": "asparagus spears or green beans",
          "QuantityAmount": 400,
          "QuantityUnit": "g",
          "GroupId": null
        },
        {
          "Name": "olive oil",
          "QuantityAmount": 1,
          "QuantityUnit": "tbsp",
          "GroupId": null
        }
      ],
      "Instructions": [
        {
          "Text": "Preheat oven to 200\u00C2\u00B0C (400\u00C2\u00B0F). Line a baking sheet with parchment paper",
          "GroupId": null
        },
        {
          "Text": "Mix melted butter, garlic, lemon juice, lemon zest, dill, parsley, salt, and pepper in a small bowl",
          "GroupId": null
        },
        {
          "Text": "Toss asparagus with olive oil and a pinch of salt. Arrange on one side of the baking sheet",
          "GroupId": null
        },
        {
          "Text": "Place salmon fillets on the other side. Spoon the lemon herb butter generously over each fillet",
          "GroupId": null
        },
        {
          "Text": "Bake 12-15 minutes until salmon flakes easily with a fork and asparagus is tender",
          "GroupId": null
        },
        {
          "Text": "Squeeze extra lemon over salmon before serving",
          "GroupId": null
        }
      ],
      "NutritionInfo": null,
      "Source": {
        "Text": "Cafe Delites",
        "Url": "https://cafedelites.com/lemon-herb-butter-salmon/"
      },
      "Tags": [
        "salmon",
        "seafood",
        "quick",
        "weeknight",
        "healthy",
        "dinner",
        "low-carb"
      ],
      "FurtherNotes": "Makes 4 servings. Prep time: 5 minutes, Cook time: 15 minutes. Internal temp should reach 63\u00C2\u00B0C (145\u00C2\u00B0F). Do not overcook or salmon will be dry. Leftovers make excellent salmon salad the next day."
    },
    {
      "Id": "d9055a20-ebe4-44a4-9c1a-7204f61a6efb",
      "Name": "Turkey Meatball Soup",
      "Description": "Hearty, nourishing soup with tender turkey meatballs, vegetables, and orzo pasta in a savory broth. Comfort in a bowl that freezes perfectly.",
      "GroupId": "1c56f246-b8fa-4f47-be38-45e9a02f6f0c",
      "Ingredients": [
        {
          "Name": "ground turkey",
          "QuantityAmount": 500,
          "QuantityUnit": "g",
          "GroupId": null
        },
        {
          "Name": "breadcrumbs",
          "QuantityAmount": 0.33,
          "QuantityUnit": "cup",
          "GroupId": null
        },
        {
          "Name": "egg",
          "QuantityAmount": 1,
          "QuantityUnit": "whole",
          "GroupId": null
        },
        {
          "Name": "garlic, minced",
          "QuantityAmount": 3,
          "QuantityUnit": "cloves",
          "GroupId": null
        },
        {
          "Name": "Italian seasoning",
          "QuantityAmount": 1.5,
          "QuantityUnit": "tsp",
          "GroupId": null
        },
        {
          "Name": "salt and pepper",
          "QuantityAmount": 1,
          "QuantityUnit": "to taste",
          "GroupId": null
        },
        {
          "Name": "olive oil",
          "QuantityAmount": 2,
          "QuantityUnit": "tbsp",
          "GroupId": null
        },
        {
          "Name": "yellow onion, diced",
          "QuantityAmount": 1,
          "QuantityUnit": "whole",
          "GroupId": null
        },
        {
          "Name": "carrots, diced",
          "QuantityAmount": 2,
          "QuantityUnit": "whole",
          "GroupId": null
        },
        {
          "Name": "celery stalks, diced",
          "QuantityAmount": 2,
          "QuantityUnit": "whole",
          "GroupId": null
        },
        {
          "Name": "diced tomatoes",
          "QuantityAmount": 400,
          "QuantityUnit": "g",
          "GroupId": null
        },
        {
          "Name": "chicken broth",
          "QuantityAmount": 6,
          "QuantityUnit": "cups",
          "GroupId": null
        },
        {
          "Name": "orzo pasta",
          "QuantityAmount": 0.75,
          "QuantityUnit": "cup",
          "GroupId": null
        },
        {
          "Name": "baby spinach",
          "QuantityAmount": 2,
          "QuantityUnit": "cups",
          "GroupId": null
        },
        {
          "Name": "Parmesan rind (optional)",
          "QuantityAmount": 1,
          "QuantityUnit": "piece",
          "GroupId": null
        },
        {
          "Name": "grated Parmesan, for serving",
          "QuantityAmount": 0.25,
          "QuantityUnit": "cup",
          "GroupId": null
        }
      ],
      "Instructions": [
        {
          "Text": "Combine ground turkey, breadcrumbs, egg, 1 clove minced garlic, half the Italian seasoning, salt, and pepper. Roll into 20-24 small meatballs",
          "GroupId": null
        },
        {
          "Text": "Heat 1 tbsp olive oil in a large pot over medium-high heat. Brown meatballs on all sides, about 4 minutes (they don\u0027t need to cook through). Remove and set aside",
          "GroupId": null
        },
        {
          "Text": "Add remaining olive oil. Saut\u00C3\u00A9 onion, carrots, and celery for 5 minutes until softened. Add remaining garlic and Italian seasoning, cook 1 minute",
          "GroupId": null
        },
        {
          "Text": "Add diced tomatoes, chicken broth, and Parmesan rind if using. Bring to a boil",
          "GroupId": null
        },
        {
          "Text": "Return meatballs to the pot, add orzo, and simmer 10-12 minutes until pasta is tender and meatballs are cooked through",
          "GroupId": null
        },
        {
          "Text": "Stir in spinach until wilted, about 1 minute. Serve topped with grated Parmesan",
          "GroupId": null
        }
      ],
      "NutritionInfo": null,
      "Source": {
        "Text": "Half Baked Harvest",
        "Url": "https://www.halfbakedharvest.com/turkey-meatball-soup/"
      },
      "Tags": [
        "soup",
        "turkey",
        "meatballs",
        "meal-prep",
        "comfort-food",
        "dinner",
        "freezer-friendly"
      ],
      "FurtherNotes": "Makes 6 servings. Prep time: 15 minutes, Cook time: 30 minutes. Storage: Refrigerate 4 days, freeze up to 3 months (freeze without orzo; cook fresh when reheating). The Parmesan rind adds incredible depth of flavor."
    },
    {
      "Id": "48cdf080-f187-4a53-a916-2b27315062d7",
