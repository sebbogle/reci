          "QuantityAmount": 1,
          "QuantityUnit": "tbsp",
          "GroupId": "5f10d5b0-e77c-4a01-b662-1fa179f9ed19"
        },
        {
          "Name": "garam masala",
          "QuantityAmount": 2,
          "QuantityUnit": "tsp",
          "GroupId": "5f10d5b0-e77c-4a01-b662-1fa179f9ed19"
        },
        {
          "Name": "turmeric",
          "QuantityAmount": 1,
          "QuantityUnit": "tsp",
          "GroupId": "5f10d5b0-e77c-4a01-b662-1fa179f9ed19"
        },
        {
          "Name": "chilli powder",
          "QuantityAmount": 1,
          "QuantityUnit": "tsp",
          "GroupId": "5f10d5b0-e77c-4a01-b662-1fa179f9ed19"
        },
        {
          "Name": "salt",
          "QuantityAmount": 1,
          "QuantityUnit": "tsp",
          "GroupId": "5f10d5b0-e77c-4a01-b662-1fa179f9ed19"
        },
        {
          "Name": "vegetable oil",
          "QuantityAmount": 2,
          "QuantityUnit": "tbsp",
          "GroupId": "4f7ece28-d488-4162-a674-1eed7e1394e9"
        },
        {
          "Name": "butter",
          "QuantityAmount": 2,
          "QuantityUnit": "tbsp",
          "GroupId": "4f7ece28-d488-4162-a674-1eed7e1394e9"
        },
        {
          "Name": "yellow onion, finely diced",
          "QuantityAmount": 1,
          "QuantityUnit": "whole",
          "GroupId": "4f7ece28-d488-4162-a674-1eed7e1394e9"
        },
        {
          "Name": "garlic, minced",
          "QuantityAmount": 4,
          "QuantityUnit": "cloves",
          "GroupId": "4f7ece28-d488-4162-a674-1eed7e1394e9"
        },
        {
          "Name": "fresh ginger, grated",
          "QuantityAmount": 1,
          "QuantityUnit": "tbsp",
          "GroupId": "4f7ece28-d488-4162-a674-1eed7e1394e9"
        },
        {
          "Name": "crushed tomatoes",
          "QuantityAmount": 400,
          "QuantityUnit": "g",
          "GroupId": "4f7ece28-d488-4162-a674-1eed7e1394e9"
        },
        {
          "Name": "heavy cream",
          "QuantityAmount": 0.75,
          "QuantityUnit": "cup",
          "GroupId": "4f7ece28-d488-4162-a674-1eed7e1394e9"
        },
        {
          "Name": "garam masala",
          "QuantityAmount": 1,
          "QuantityUnit": "tbsp",
          "GroupId": "4f7ece28-d488-4162-a674-1eed7e1394e9"
        },
        {
          "Name": "sugar",
          "QuantityAmount": 1,
          "QuantityUnit": "tsp",
          "GroupId": "4f7ece28-d488-4162-a674-1eed7e1394e9"
        },
        {
          "Name": "fresh cilantro",
          "QuantityAmount": 2,
          "QuantityUnit": "tbsp",
          "GroupId": "4f7ece28-d488-4162-a674-1eed7e1394e9"
        },
        {
          "Name": "basmati rice, for serving",
          "QuantityAmount": 2,
          "QuantityUnit": "cups",
          "GroupId": "4f7ece28-d488-4162-a674-1eed7e1394e9"
        }
      ],
      "Instructions": [
        {
          "Text": "Combine chicken with yogurt, lemon juice, garam masala, turmeric, chilli powder, and salt. Marinate at least 30 minutes (overnight is best)",
          "GroupId": "4f4c5d4a-b06f-4dad-b886-f2564c0018a8"
        },
        {
          "Text": "Heat oil in a large pan over high heat. Cook marinated chicken in batches 3-4 minutes per side until charred. Set aside",
          "GroupId": "4f4c5d4a-b06f-4dad-b886-f2564c0018a8"
        },
        {
          "Text": "In the same pan, melt butter over medium heat. Saut\u00C3\u00A9 onion 5 minutes until softened",
          "GroupId": "7ea54e46-844b-48f0-9902-7428e6a05763"
        },
        {
          "Text": "Add garlic and ginger, cook 1 minute. Stir in garam masala and cook 30 seconds",
          "GroupId": "7ea54e46-844b-48f0-9902-7428e6a05763"
        },
        {
          "Text": "Add crushed tomatoes and sugar. Simmer 15 minutes, stirring occasionally, until sauce thickens",
          "GroupId": "7ea54e46-844b-48f0-9902-7428e6a05763"
        },
        {
          "Text": "Stir in heavy cream and return chicken to the sauce. Simmer 5-8 minutes until chicken is cooked through",
          "GroupId": "7ea54e46-844b-48f0-9902-7428e6a05763"
        },
        {
          "Text": "Garnish with cilantro and serve over basmati rice",
          "GroupId": "7ea54e46-844b-48f0-9902-7428e6a05763"
        }
      ],
      "NutritionInfo": null,
      "Source": {
        "Text": "RecipeTin Eats",
        "Url": "https://www.recipetineats.com/chicken-tikka-masala/"
      },
      "Tags": [
        "chicken",
        "indian",
        "curry",
        "meal-prep",
        "dinner",
        "comfort-food",
        "batch-cooking"
      ],
      "FurtherNotes": "Makes 5 servings. Prep time: 15 minutes (plus marinating), Cook time: 35 minutes. Storage: Refrigerate 4 days, freezes well for up to 3 months. Sauce improves overnight. Use coconut cream for dairy-free version."
    },
    {
      "Id": "6376364f-9e9b-40a0-b956-973fb414ec8a",
      "Name": "Greek Chicken Bowl",
      "Description": "Juicy lemon-herb grilled chicken over rice with cucumber, tomatoes, red onion, and a cool creamy tzatziki. A fresh, satisfying meal prep bowl.",
      "GroupId": "caaa3392-bcc9-42ac-99d4-55cf208229e8",
      "Ingredients": [
        {
          "Name": "boneless skinless chicken breasts",
