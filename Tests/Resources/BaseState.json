        { "Text": "Add ground beef and cook until browned, breaking it apart.", "GroupId": "40000000-0000-0000-0000-000000000001" },
        { "Text": "Stir in crushed tomatoes and tomato paste. Simmer for 20 minutes.", "GroupId": "40000000-0000-0000-0000-000000000001" },
