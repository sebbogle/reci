        { "Name": "Salt and pepper", "QuantityAmount": 1, "QuantityUnit": "to taste", "GroupId": null }
      ],
      "Instructions": [
        { "Text": "Heat olive oil in a large pan over medium heat. Saute onion until translucent.", "GroupId": "40000000-0000-0000-0000-000000000001" },
