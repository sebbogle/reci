      "Id": "20000000-0000-0000-0000-000000000001",
      "Name": "Classic Pancakes",
      "Description": "Fluffy golden pancakes perfect for weekend mornings",
      "GroupId": "10000000-0000-0000-0000-000000000001",
      "Ingredients": [
        { "Name": "All-purpose flour", "QuantityAmount": 1.5, "QuantityUnit": "cups", "GroupId": null },
        { "Name": "Milk", "QuantityAmount": 1.25, "QuantityUnit": "cups", "GroupId": null },
        { "Name": "Egg", "QuantityAmount": 1, "QuantityUnit": "", "GroupId": null },
        { "Name": "Butter (melted)", "QuantityAmount": 3, "QuantityUnit": "tbsp", "GroupId": null },
        { "Name": "Sugar", "QuantityAmount": 2, "QuantityUnit": "tbsp", "GroupId": null },
        { "Name": "Baking powder", "QuantityAmount": 1, "QuantityUnit": "tbsp", "GroupId": null },
        { "Name": "Salt", "QuantityAmount": 0.25, "QuantityUnit": "tsp", "GroupId": null }
      ],
      "Instructions": [
        { "Text": "Whisk together flour, sugar, baking powder, and salt in a large bowl.", "GroupId": null },
        { "Text": "In a separate bowl, beat the egg and add milk and melted butter.", "GroupId": null },
        { "Text": "Pour wet ingredients into dry and stir until just combined.", "GroupId": null },
        { "Text": "Heat a lightly oiled griddle over medium-high heat.", "GroupId": null },
        { "Text": "Pour batter onto griddle using approximately 1/4 cup per pancake.", "GroupId": null },
        { "Text": "Cook until bubbles form on the surface, then flip and cook until golden brown.", "GroupId": null }
      ],
      "NutritionInfo": {
        "Calories": 350,
        "Fat": 12.5,
        "Carbohydrates": 48.0,
        "Protein": 9.0
      },
      "Source": {
        "Text": "Family Recipe",
        "Url": null
      },
      "Tags": [ "breakfast", "quick" ],
      "FurtherNotes": "For extra fluffy pancakes, let the batter rest for 5 minutes before cooking."
    },
