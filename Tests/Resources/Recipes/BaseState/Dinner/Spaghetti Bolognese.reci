  "instructions": [
    { "text": "Heat olive oil in a large pan over medium heat. Saute onion until translucent.", "group": "Sauce" },
    { "text": "Add garlic and cook for 1 minute.", "group": "Sauce" },
    { "text": "Add ground beef and cook until browned, breaking it apart.", "group": "Sauce" },
    { "text": "Stir in crushed tomatoes and tomato paste. Simmer for 20 minutes.", "group": "Sauce" },
    { "text": "Cook spaghetti according to package directions. Drain.", "group": "Assembly" },
    { "text": "Serve sauce over spaghetti.", "group": "Assembly" }
