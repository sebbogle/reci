  "name": "Chicken Tikka Masala",
  "description": "Tender marinated chicken pieces swimming in a rich, creamy spiced tomato sauce. Better than takeaway and perfect for batch cooking.",
  "group": "Meal Prep - Chicken",
  "ingredients": [
    {
      "name": "boneless skinless chicken thighs, cubed",
      "quantityAmount": 1,
      "quantityUnit": "kg",
      "group": "Marinated Chicken"
    },
    {
      "name": "plain yogurt",
      "quantityAmount": 0.5,
      "quantityUnit": "cup",
      "group": "Marinated Chicken"
    },
    {
      "name": "lemon juice",
      "quantityAmount": 1,
      "quantityUnit": "tbsp",
      "group": "Marinated Chicken"
    },
    {
      "name": "garam masala",
      "quantityAmount": 2,
      "quantityUnit": "tsp",
      "group": "Marinated Chicken"
    },
    {
      "name": "turmeric",
      "quantityAmount": 1,
      "quantityUnit": "tsp",
      "group": "Marinated Chicken"
    },
    {
      "name": "chilli powder",
      "quantityAmount": 1,
      "quantityUnit": "tsp",
      "group": "Marinated Chicken"
    },
    {
      "name": "salt",
      "quantityAmount": 1,
      "quantityUnit": "tsp",
      "group": "Marinated Chicken"
    },
    {
      "name": "vegetable oil",
      "quantityAmount": 2,
      "quantityUnit": "tbsp",
      "group": "Masala Sauce"
    },
    {
      "name": "butter",
      "quantityAmount": 2,
      "quantityUnit": "tbsp",
      "group": "Masala Sauce"
    },
    {
      "name": "yellow onion, finely diced",
      "quantityAmount": 1,
      "quantityUnit": "whole",
      "group": "Masala Sauce"
    },
    {
      "name": "garlic, minced",
      "quantityAmount": 4,
      "quantityUnit": "cloves",
      "group": "Masala Sauce"
    },
    {
      "name": "fresh ginger, grated",
      "quantityAmount": 1,
      "quantityUnit": "tbsp",
      "group": "Masala Sauce"
    },
    {
      "name": "crushed tomatoes",
      "quantityAmount": 400,
      "quantityUnit": "g",
      "group": "Masala Sauce"
    },
    {
      "name": "heavy cream",
      "quantityAmount": 0.75,
      "quantityUnit": "cup",
      "group": "Masala Sauce"
    },
    {
      "name": "garam masala",
      "quantityAmount": 1,
      "quantityUnit": "tbsp",
      "group": "Masala Sauce"
    },
    {
      "name": "sugar",
      "quantityAmount": 1,
      "quantityUnit": "tsp",
      "group": "Masala Sauce"
    },
    {
      "name": "fresh cilantro",
      "quantityAmount": 2,
      "quantityUnit": "tbsp",
      "group": "Masala Sauce"
    },
    {
      "name": "basmati rice, for serving",
      "quantityAmount": 2,
      "quantityUnit": "cups",
      "group": "Masala Sauce"
    }
  ],
  "instructions": [
    {
      "text": "Combine chicken with yogurt, lemon juice, garam masala, turmeric, chilli powder, and salt. Marinate at least 30 minutes (overnight is best)",
      "group": "Marinate & Cook Chicken"
    },
    {
      "text": "Heat oil in a large pan over high heat. Cook marinated chicken in batches 3-4 minutes per side until charred. Set aside",
      "group": "Marinate & Cook Chicken"
    },
    {
      "text": "In the same pan, melt butter over medium heat. SautÃ© onion 5 minutes until softened",
      "group": "Make Sauce"
    },
    {
      "text": "Add garlic and ginger, cook 1 minute. Stir in garam masala and cook 30 seconds",
      "group": "Make Sauce"
    },
    {
      "text": "Add crushed tomatoes and sugar. Simmer 15 minutes, stirring occasionally, until sauce thickens",
      "group": "Make Sauce"
    },
    {
      "text": "Stir in heavy cream and return chicken to the sauce. Simmer 5-8 minutes until chicken is cooked through",
      "group": "Make Sauce"
    },
    {
      "text": "Garnish with cilantro and serve over basmati rice",
      "group": "Make Sauce"
    }
  ],
  "source": {
