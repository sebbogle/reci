@page "/"
@page "/group/{GroupName}"
@implements IAsyncDisposable
@inject IRecipeService RecipeService
@inject IRecipeStateNotifier RecipeStateNotifier
@inject NavigationManager NavigationManager

<PageTitle>@(GroupName ?? "Contents")</PageTitle>

@if (isLoading)
{
    <LoadingSpinner />
}
else if (GroupName is not null && (filteredSummaries is null || !filteredSummaries.Any()))
{
    <ItemNotFound ItemTypeLabel="group" />
}
else if (filteredSummaries is null || !filteredSummaries.Any())
{
    <FluentStack Orientation="Orientation.Vertical"
                 VerticalGap="15"
                 HorizontalAlignment="HorizontalAlignment.Center"
                 Style="margin-top: 50px;">
        <FluentLabel Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
            No recipes found. Start by adding your first recipe!
        </FluentLabel>
    </FluentStack>
}
else
{
    <div>
    <FluentGrid Spacing="2" Justify="JustifyContent.FlexStart">
        @foreach (IGrouping<string?, RecipeSummary> group in filteredSummaries.GroupBy(r => r.Group).OrderBy(g => g.Key ?? string.Empty))
        {
            @if (!string.IsNullOrEmpty(group.Key) && GroupName == null)
            {
                <FluentGridItem xs="12">
                    <FluentLabel Typo="Typography.H3">@group.Key</FluentLabel>
                </FluentGridItem>
            }

            @foreach (RecipeSummary recipe in group)
            {
                string anchorId = $"description-{recipe.Slug.GetHashCode():x}";
                <FluentGridItem xs="12" sm="6" md="4" lg="3" @key="recipe.Slug">
                    <FluentCard class="recipe-card" MinimalStyle="true" @onclick="() => NavigateToRecipe(recipe)">
                        <FluentStack Orientation="Orientation.Vertical">
                            <FluentLabel Typo="Typography.H5">@recipe.Name</FluentLabel>

                            @if (!string.IsNullOrEmpty(recipe.Description))
                            {
                                <FluentLabel Id="@anchorId" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="recipe-description">@recipe.Description</FluentLabel>
                                <FluentTooltip Anchor="@anchorId" Position="TooltipPosition.Bottom" Delay="500" MaxWidth="300px">
                                    @recipe.Description
                                </FluentTooltip>
                            }
                            @if (recipe.Tags.Any())
                            {
                                <FluentStack HorizontalGap="3" Wrap="true">
                                    @foreach (string tag in recipe.Tags)
                                    {
                                        <FluentBadge Appearance="Appearance.Accent">@tag</FluentBadge>
                                    }
                                </FluentStack>
                            }
                        </FluentStack>
                    </FluentCard>
                </FluentGridItem>
            }
            <FluentGridItem xs="12" Style="margin-bottom: 10px;"></FluentGridItem>
        }
    </FluentGrid>
    </div>
}

@code {
    [Parameter]
    public string? GroupName { get; set; }

    private List<RecipeSummary>? allSummaries;
    private List<RecipeSummary>? filteredSummaries;
    private bool isLoading = true;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        RecipeStateNotifier.Subscribe(OnRecipesChanged);
        await LoadRecipes();
    }

    protected override void OnParametersSet()
    {
        FilterRecipes();
    }

    private async Task LoadRecipes()
    {
        try
        {
            allSummaries = await RecipeService.GetRecipeSummariesAsync(_cts.Token);
            FilterRecipes();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnRecipesChanged()
    {
        try
        {
            if (_cts.Token.IsCancellationRequested) return;
            await LoadRecipes();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Component is being disposed, ignore.
        }
        catch (ObjectDisposedException)
        {
            // Component already disposed, ignore.
        }
    }

    public ValueTask DisposeAsync()
    {
        RecipeStateNotifier.Unsubscribe(OnRecipesChanged);
        _cts.Cancel();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }

    private void FilterRecipes()
    {
        if (allSummaries == null)
        {
            filteredSummaries = null;
            return;
        }

        if (GroupName is not null)
        {
            filteredSummaries = allSummaries
                .Where(r => string.Equals(r.Group, GroupName, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        else
        {
            filteredSummaries = allSummaries;
        }
    }

    private void NavigateToRecipe(RecipeSummary recipe)
    {
        NavigationManager.NavigateTo($"/recipe/{recipe.Slug}");
    }
}
